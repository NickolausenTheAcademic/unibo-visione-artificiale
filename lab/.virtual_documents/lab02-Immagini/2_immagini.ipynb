# --- Svolgimento Esercizio 6: Inizio --- #
toys_hsv = cv.cvtColor(cv.imread("immagini/toys.png"), cv.COLOR_BGR2HSV)
h, s, v = cv.split(toys_hsv)

# Prima riga
va.show((toys_hsv, "Originale"), (h, "H"), (s, "S"), (v, "V"))
# Fine prima riga

# Seconda riga
out = []
for k in [0, np.pi / 4, np.pi / 2, 3 * np.pi / 4]:
    out.append((cv.merge((np.full_like(h, np.rad2deg(k)), s, v)), f"H = {k}, S, V"))
va.show(*out)
# Fine seconda riga

# Terza riga
out = []
for k in [0, 1 / 4, 1 / 2, 1]:
    out.append((cv.merge((h, np.full_like(s, k * 255), v)), f"H, S = {k}, V"))
va.show(*out)
# Fine terza riga

# Quarta riga
out = []
for k in [0, 1 / 4, 1 / 2, 1]:
    out.append((cv.merge((h, s, np.full_like(v, k * 255))), f"H, S, V = {k}"))
va.show(*out)
# Fine quarta riga

# Quinta riga
va.show(
    (cv.merge((np.full_like(h, np.rad2deg((h + np.pi / 4) % (2 * np.pi))), s, v)), "H + π/4, S, V"),
    (cv.merge((np.full_like(h, np.rad2deg((h + np.pi / 2) % (2 * np.pi))), s, v)), "H + π/2, S, V"),
    (cv.merge((h, s, np.full_like(v, v // 2))), "H, S, V // 2"),
    (cv.merge((h, s, np.full_like(v, v // 4))), "H, S, V // 4")
)
# Fine quinta riga
